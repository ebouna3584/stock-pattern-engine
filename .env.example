# Copy this file to .env and fill in real values. .env is gitignored.

# Anthropic API key — powers AI trade thesis synthesis + article curation.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# NewsAPI key — primary source for ticker news (https://newsapi.org).
# If left blank, the app falls back to yfinance news, then Google News RSS (no key needed).
NEWS_API_KEY=

# Accounts — SQLite works with zero setup for local dev. Before deploying to
# Vercel, replace with a hosted Postgres URL (e.g. Neon or Supabase free tier):
# postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./app.db

# Random long string — used to sign login sessions. Generate one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Resend (https://resend.com) — sends verification emails + the newsletter.
# Free tier is generous; without a key, emails are logged instead of sent.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Base URL used to build links inside emails (verification, etc).
APP_BASE_URL=http://localhost:8000

# Only this email can approve/send the newsletter or reach admin endpoints.
ADMIN_EMAIL=

# Comma-separated list of origins allowed to call the API with cookies.
# Add your Vercel domain here once you know it, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:8000,https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
