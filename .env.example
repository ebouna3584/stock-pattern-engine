# Copy this file to .env and fill in real values. .env is gitignored.

# Anthropic API key — powers AI trade thesis synthesis + article curation.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# NewsAPI key — primary source for ticker news (https://newsapi.org).
# If left blank, the app falls back to yfinance news, then Google News RSS (no key needed).
NEWS_API_KEY=
